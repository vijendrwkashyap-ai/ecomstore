"use client";
import React, { useState, useEffect } from "react";
import Link from "next/link";
import { useCart } from "@/context/CartContext";
import ShiprocketButton from "@/components/ShiprocketButton";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

interface ProductPageClientProps {
  product: any;
  relatedProducts: any[];
}

export default function ProductPageClient({ product, relatedProducts }: ProductPageClientProps) {
  const [selectedSize, setSelectedSize] = useState("30");
  const [quantity, setQuantity] = useState(1);
  const [currentSlide, setCurrentSlide] = useState(0);
  const { addToCart } = useCart();
  
  const sliderImages = Array(5).fill(product.src);

  const handleDecrease = () => setQuantity(prev => Math.max(1, prev - 1));
  const handleIncrease = () => setQuantity(prev => prev + 1);

  useEffect(() => {
    const ctx = gsap.context(() => {
      gsap.from(".anim-item", {
        y: 10,
        opacity: 0,
        duration: 0.5,
        stagger: 0.04,
        ease: "power2.out",
        scrollTrigger: {
          trigger: ".info-content",
          start: "top 95%",
        }
      });
    });
    return () => ctx.revert();
  }, []);

  return (
    <main className="w-full bg-white relative pb-32 md:pb-20 font-sans selection:bg-black selection:text-white">
      
      {/* Global Header Clearance */}
      <div className="w-full h-20 md:h-28 bg-white" />

      {/* Desktop Breadcrumbs & Hierarchy */}
      <div className="w-full max-w-[1440px] mx-auto px-6 md:px-12 pb-6 hidden md:flex justify-between items-center text-[10px] uppercase tracking-[0.15em] font-semibold text-zinc-400">
         <div className="flex gap-2 items-center">
            <Link href="/" className="hover:text-black">HQ</Link>
            <span>/</span>
            <Link href="/shop" className="hover:text-black">Archive Sector</Link>
            <span>/</span>
            <span className="text-black">{product.title}</span>
         </div>
         <span className="font-bold tracking-widest">DenimX Authority</span>
      </div>

      <div className="w-full max-w-[1440px] mx-auto flex flex-col lg:flex-row lg:gap-16 px-0 md:px-12 relative items-start">
        
        {/* ========================================================
            LEFT COLUMN: UNOBSTRUCTED PRODUCT IMAGERY
            ======================================================== */}
        <div className="w-full lg:w-[50%] xl:w-[55%] lg:sticky lg:top-28 flex flex-col group relative">
           
           {/* Mobile Breadcrumb */}
           <div className="absolute top-4 left-6 z-10 md:hidden flex items-center gap-2 text-[9px] uppercase tracking-[0.15em] font-bold text-black bg-white/80 backdrop-blur-md px-3 py-1.5 rounded-sm shadow-sm border border-black/5">
             <Link href="/">HQ</Link>
             <span className="text-black/30">/</span>
             <Link href="/shop">Archive</Link>
           </div>

           {/* Editorial Image Pagination */}
           <div className="absolute top-4 right-6 md:top-6 md:right-6 z-10 flex text-[9px] uppercase tracking-[0.2em] font-bold text-black bg-white/80 backdrop-blur-md px-3 py-1.5 rounded-sm shadow-sm border border-black/5">
              <span>{String(currentSlide + 1).padStart(2, '0')}</span>
              <span className="mx-1 text-black/30">/</span>
              <span>{String(sliderImages.length).padStart(2, '0')}</span>
           </div>

           {/* Pure Native Snap Slider */}
           <div 
             className="flex w-full overflow-x-auto snap-x snap-mandatory hide-scroll md:rounded-[2px] bg-zinc-50 border border-black/5"
             onScroll={(e) => {
               const slideWidth = e.currentTarget.clientWidth;
               const index = Math.round(e.currentTarget.scrollLeft / slideWidth);
               setCurrentSlide(index);
             }}
           >
             {sliderImages.map((img, idx) => (
                <div key={idx} className="min-w-full h-[60vh] max-h-[550px] md:max-h-none md:h-[65vh] xl:h-[680px] snap-center relative shrink-0">
                   <img src={img} alt={`${product.title} - angle ${idx + 1}`} className="w-full h-full object-cover object-[center_top] mix-blend-multiply" loading={idx === 0 ? "eager" : "lazy"} />
                </div>
             ))}
           </div>

           {/* Minimal Dots Array */}
           <div className="flex justify-center gap-1.5 mt-4 absolute md:relative bottom-6 w-full md:bottom-auto md:mt-6 z-10">
              {sliderImages.map((_, idx) => (
                 <button 
                   aria-label={`Go to slide ${idx + 1}`}
                   key={idx} 
                   className={`h-[3px] rounded-full transition-all duration-500 ease-out ${currentSlide === idx ? 'w-8 bg-black shadow-md' : 'w-3 bg-black/15 hover:bg-black/30'}`} 
                 />
              ))}
           </div>
        </div>

        {/* ========================================================
            RIGHT COLUMN: INFORMATION DENSITY & AUTHORITY
            ======================================================== */}
        <div className="w-full lg:w-[50%] xl:w-[45%] flex flex-col px-6 md:px-0 py-8 lg:py-0 info-content">
           
           {/* 1. METADATA HEADER */}
           <div className="flex justify-between items-start pb-5 border-b border-black/10 anim-item">
              <div className="flex flex-col gap-1.5 text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500">
                <span className="text-black">DenimX Authority Division</span>
                <span>Serial: DNMX-014-{product.id}-BLK</span>
              </div>
              <div className="flex flex-col items-end gap-1.5">
                 <div className="flex gap-2">
                    <span className="px-1.5 py-0.5 bg-black/5 text-[9px] font-bold uppercase tracking-widest text-zinc-600 rounded-[2px] shadow-sm">FW26</span>
                    <span className="px-1.5 py-0.5 bg-black/5 text-[9px] font-bold uppercase tracking-widest text-zinc-600 rounded-[2px] shadow-sm">Vanguard</span>
                 </div>
                 <span className="text-[9px] font-bold uppercase tracking-widest text-zinc-400 mt-1 flex items-center gap-1.5">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    Authenticity Verified
                 </span>
              </div>
           </div>

           {/* 2. TITLE & COMMERCE MATRIX */}
           <div className="flex flex-col gap-4 py-8 border-b border-black/10 anim-item">
              <h1 className="text-3xl md:text-5xl font-black tracking-tight text-black leading-[1.05] uppercase">
                  {product.title}
              </h1>
              <div className="flex flex-col md:flex-row md:items-center gap-3 md:gap-6 mt-1">
                  <span className="text-2xl font-bold tracking-tight text-black">₹{product.price}</span>
                  <div className="flex items-center gap-2">
                     <span className="text-[9px] font-extrabold text-black uppercase tracking-widest px-2 py-1 border border-black/20 rounded-[2px] shadow-sm bg-black/5">Duty Free</span>
                     <span className="text-[10px] font-bold text-zinc-500 uppercase tracking-[0.15em]">Inclusive of all taxes</span>
                  </div>
              </div>
              <div className="flex flex-col gap-1.5 mt-2 px-4 py-3.5 bg-zinc-50 border border-black/5 rounded-[4px] shadow-sm">
                 <div className="flex items-center gap-2 text-[11px] font-extrabold text-black uppercase tracking-widest">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                    Pay in 3 interest-free installments
                 </div>
                 <span className="text-[11px] text-zinc-500 font-medium pl-[22px]">Available with valid domestic credit cards at checkout. <span className="underline cursor-pointer hover:text-black decoration-zinc-300 hover:decoration-black underline-offset-4 transition-colors">Learn More</span></span>
              </div>
           </div>

           {/* 3. TECHNICAL SPECIFICATIONS MINI-GRID */}
           <div className="py-8 border-b border-zinc-200 anim-item">
              <div className="grid grid-cols-2 md:grid-cols-4 gap-y-6 gap-x-4">
                 <div className="flex flex-col gap-1.5">
                    <span className="text-[9px] uppercase font-bold tracking-[0.2em] text-zinc-400">Colorway</span>
                    <span className="text-[12px] font-extrabold tracking-wide text-black uppercase">Onyx Black</span>
                 </div>
                 <div className="flex flex-col gap-1.5">
                    <span className="text-[9px] uppercase font-bold tracking-[0.2em] text-zinc-400">Composition</span>
                    <span className="text-[12px] font-extrabold tracking-wide text-black uppercase">14.5oz Raw</span>
                 </div>
                 <div className="flex flex-col gap-1.5">
                    <span className="text-[9px] uppercase font-bold tracking-[0.2em] text-zinc-400">Silhouette</span>
                    <span className="text-[12px] font-extrabold tracking-wide text-black uppercase">Wide-Leg</span>
                 </div>
                 <div className="flex flex-col gap-1.5">
                    <span className="text-[9px] uppercase font-bold tracking-[0.2em] text-zinc-400">Production</span>
                    <span className="text-[12px] font-extrabold tracking-wide text-black uppercase">Japan</span>
                 </div>
              </div>
           </div>

           {/* 4. SIZING ROW WITH MODEL INFO */}
           <div className="flex flex-col gap-6 py-8 border-b border-zinc-200 anim-item">
              <div className="flex justify-between items-center text-[10px] font-bold tracking-[0.2em] uppercase text-black">
                <span>Configure Dimensions</span>
                <span className="text-zinc-500 underline underline-offset-4 cursor-pointer hover:text-black transition-colors">Size Guide</span>
              </div>
              
              <div className="grid grid-cols-5 gap-2 md:gap-3">
                {['28','30','32','34','36'].map((size) => (
                  <button key={size}
                    onClick={() => setSelectedSize(size)}
                    className={`h-[48px] border flex items-center justify-center font-bold text-[13px] transition-all rounded-[2px] ${selectedSize === size ? 'border-black bg-black text-white shadow-sm' : 'border-zinc-300 bg-white text-black hover:border-black'}`}
                  >
                    {size}
                  </button>
                ))}
              </div>

              <div className="flex items-start gap-3 mt-2">
                 <svg className="w-4 h-4 mt-0.5 text-zinc-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                 <p className="text-[12px] leading-relaxed text-zinc-600 font-medium tracking-wide">
                    <span className="font-bold text-black border-none">Model Metrics:</span> Height 188cm / 6'2", Waist 30, Chest 38. Model is wearing a structural <strong className="text-black">Size 30</strong>.<br/>This garment features a deliberate oversized drape. Take your normal size for the intended fit.
                 </p>
              </div>
           </div>

           {/* 5. LIVE STOCK / DISPATCH PULSE */}
           <div className="py-6 flex items-center gap-3 anim-item border-b border-zinc-200">
              <div className="relative flex h-2.5 w-2.5 shrink-0">
                 <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                 <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              </div>
              <span className="text-[10px] md:text-[11px] font-bold uppercase tracking-[0.1em] text-black">In Stock at Vault. Order within <span className="text-emerald-600">14h 32m</span> for Priority Dispatch today.</span>
           </div>

           {/* 6. CONVERSION ENGINE (Buttons) */}
           <div className="flex flex-col gap-4 py-8 anim-item">
              <div className="flex gap-4 h-[52px]">
                 {/* Quantity Component */}
                 <div className="flex items-center justify-between w-[120px] bg-white border border-zinc-300 rounded-[2px] px-2 shadow-sm shrink-0">
                   <button onClick={handleDecrease} className="w-10 h-full flex items-center justify-center text-zinc-400 hover:text-black text-lg transition-colors">-</button>
                   <span className="font-bold text-[13px] select-none text-black">{quantity}</span>
                   <button onClick={handleIncrease} className="w-10 h-full flex items-center justify-center text-zinc-400 hover:text-black text-lg transition-colors">+</button>
                 </div>
                 
                 {/* Add to System Button */}
                 <button 
                   onClick={() => addToCart({ id: product.id, title: product.title, price: product.price, size: selectedSize, image: product.src, quantity: quantity })}
                   className="flex-1 h-full bg-white text-black border border-black font-bold text-[11px] md:text-xs uppercase tracking-widest rounded-[2px] hover:bg-zinc-50 transition-colors shadow-sm"
                 >
                   Add To Bag
                 </button>
              </div>

              {/* Express Buy Component */}
              <div className="w-full h-[52px] group">
                 <ShiprocketButton
                   productId={product.id}
                   quantity={quantity}
                   text="BUY NOW"
                   className="h-full !py-0 w-full rounded-[2px] shadow-sm hover:shadow-md bg-black hover:bg-zinc-900 border border-black"
                 />
              </div>

              {/* Delivery Promise Snippet */}
              <div className="flex flex-col gap-2 p-4 mt-2 bg-zinc-50 border border-zinc-100 rounded-[2px]">
                  <div className="flex justify-between items-center">
                     <span className="text-[11px] font-bold uppercase tracking-widest text-zinc-500">Est. Arrival</span>
                     <span className="text-[11px] font-bold uppercase tracking-widest text-black">Apr 04 – Apr 07</span>
                  </div>
                  <div className="flex justify-between items-center">
                     <span className="text-[11px] font-bold uppercase tracking-widest text-zinc-500">Shipping</span>
                     <span className="text-[11px] font-bold uppercase tracking-widest text-black">Free Priority Transit</span>
                  </div>
              </div>
           </div>

           {/* 7. EXPERT LEVEL ACCORDIONS */}
           <div className="flex flex-col py-2 anim-item">
              <details className="group border-b border-black/10 py-7 [&_summary::-webkit-details-marker]:hidden">
                 <summary className="flex justify-between items-center font-bold text-[11px] uppercase tracking-widest text-black cursor-pointer select-none outline-none">
                    <span>Design & Philosophy</span>
                    <span className="text-zinc-400 group-hover:text-black transition-colors relative flex items-center justify-center w-4 h-4">
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300"></span>
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300 rotate-90 group-open:rotate-0 group-open:bg-transparent"></span>
                    </span>
                 </summary>
                 <div className="text-[13px] text-zinc-600 leading-relaxed pt-6 font-medium tracking-wide">
                    Rooted in brutalist architecture, this silhouette defies traditional boundaries. Each pair undergoes a 48-hour mechanical wash process to achieve the deliberate vintage patina. Custom-casted zinc hardware secures pivotal stress points.
                 </div>
              </details>
              
              <details className="group border-b border-black/10 py-7 [&_summary::-webkit-details-marker]:hidden">
                 <summary className="flex justify-between items-center font-bold text-[11px] uppercase tracking-widest text-black cursor-pointer select-none outline-none">
                    <span>Material & Care Protocol</span>
                    <span className="text-zinc-400 group-hover:text-black transition-colors relative flex items-center justify-center w-4 h-4">
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300"></span>
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300 rotate-90 group-open:rotate-0 group-open:bg-transparent"></span>
                    </span>
                 </summary>
                 <div className="pt-6 flex flex-col gap-4">
                    <p className="text-[13px] text-zinc-600 font-medium">100% Cotton / 14.5oz Japanese Kuroki Raw Selvedge.</p>
                    <ul className="text-[13px] text-zinc-500 font-medium list-disc pl-5 flex flex-col gap-2">
                       <li>Machine wash cold / Gentle cycle.</li>
                       <li>Do not deploy bleach or chemical agents.</li>
                       <li>Hang dry strictly in shade.</li>
                       <li>Iron on reverse at absolute low temperature.</li>
                    </ul>
                 </div>
              </details>
              
              <details className="group border-b border-black/10 py-7 [&_summary::-webkit-details-marker]:hidden">
                 <summary className="flex justify-between items-center font-bold text-[11px] uppercase tracking-widest text-black cursor-pointer select-none outline-none">
                    <span>Shipping, Returns & Ethics</span>
                    <span className="text-zinc-400 group-hover:text-black transition-colors relative flex items-center justify-center w-4 h-4">
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300"></span>
                       <span className="absolute w-[12px] h-[2px] bg-current transition-transform duration-300 rotate-90 group-open:rotate-0 group-open:bg-transparent"></span>
                    </span>
                 </summary>
                 <div className="pt-6 flex flex-col gap-5 text-[13px] text-zinc-600 font-medium leading-relaxed tracking-wide">
                    <p><strong className="text-black font-extrabold">Ethical Sourcing:</strong> Manufactured in highly monitored facilities guaranteeing fair wage compliance and zero forced labor.</p>
                    <p><strong className="text-black font-extrabold">14-Day Global Protocol:</strong> We accept returns strictly within 14 days. The garment must remain in absolute original condition with all authenticity mechanisms, security RFID tags, and seals unbroken.</p>
                 </div>
              </details>
           </div>
           
           {/* Trust Footers */}
           <div className="flex gap-4 justify-center py-10 opacity-60">
                 <span className="text-[9px] font-bold tracking-[0.25em] uppercase text-zinc-500">100% Genuine</span> •
                 <span className="text-[9px] font-bold tracking-[0.25em] uppercase text-zinc-500">256-bit Secure</span> •
                 <span className="text-[9px] font-bold tracking-[0.25em] uppercase text-zinc-500">Buyer Protection</span>
           </div>

        </div>
      </div>

      {/* ========================================================
          RELATED PRODUCTS (ARCHIVE EXTENSION)
          ======================================================== */}
      <section className="w-full max-w-[1440px] mx-auto mt-20 px-6 md:px-12 pb-20">
        <div className="flex flex-col gap-10">
           <div className="border-b border-zinc-200 pb-6 w-full flex justify-between items-end">
              <div>
                 <span className="text-zinc-400 text-[10px] font-bold tracking-[0.3em] uppercase mb-2 block">Archive Extension</span>
                 <h2 className="text-2xl md:text-3xl font-extrabold tracking-tight uppercase text-black">RELATED FORMS</h2>
              </div>
              <Link href="/shop" className="hidden md:block text-[10px] font-bold tracking-[0.2em] uppercase text-black hover:underline underline-offset-4">VIEW ALL</Link>
           </div>
           
           <div className="flex gap-4 md:gap-6 overflow-x-auto hide-scroll snap-x snap-mandatory">
              {relatedProducts && relatedProducts.slice(0, 4).map((p, i) => (
                <Link href={`/product/${p.id}`} key={i} className="min-w-[70vw] md:min-w-[0] md:flex-1 flex flex-col gap-4 group snap-start">
                  <div className="w-full aspect-[4/5] overflow-hidden bg-zinc-100 relative rounded-[2px] border border-zinc-100">
                    <img src={p.src} alt={p.title} className="w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
                  </div>
                  <div className="flex flex-col gap-1">
                    <h3 className="text-black font-bold text-[13px] uppercase tracking-wide">{p.title}</h3>
                    <p className="text-zinc-600 font-semibold text-sm">₹{p.price}</p>
                  </div>
                </Link>
              ))}
           </div>
        </div>
      </section>

      {/* ========================================================
          MOBILE STICKY ACTION BAR
          ======================================================== */}
      <div className="fixed bottom-0 left-0 w-full z-[60] bg-white border-t border-zinc-200 p-4 pb-safe flex gap-3 md:hidden shadow-[0_-5px_20px_rgba(0,0,0,0.05)] translate-y-0 transition-transform duration-500">
         <button 
           onClick={() => addToCart({ id: product.id, title: product.title, price: product.price, size: selectedSize, image: product.src, quantity: quantity })}
           className="flex-1 h-[52px] text-[11px] font-bold tracking-[0.1em] uppercase border border-zinc-300 bg-white text-black hover:bg-zinc-50 rounded-[2px] transition-colors"
         >
           Add To Bag
         </button>
         <div className="flex-[2] h-[52px] rounded-[2px] overflow-hidden">
            <ShiprocketButton
              productId={product.id}
              quantity={quantity}
              text="BUY NOW"
              className="h-full !py-0 w-full border-none shadow-none"
            />
         </div>
      </div>

    </main>
  );
}
